PORT=3000
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
# Janela temporal usada na análise de tendência e intervalo de amostragem
WINDOW_MS=900000
SAMPLE_INTERVAL_MS=5000
# Política de alertas
CONFIRM_READINGS=2
DEESCALATE_AFTER_MS=60000
ACK_SNOOZE_MS=600000
RENOTIFY_CRITICAL_MS=60000
RENOTIFY_HIGH_MS=300000
RENOTIFY_MEDIUM_MS=900000
# Perda de sinal
SIGNAL_TIMEOUT_MS=15000
WATCHDOG_INTERVAL_MS=5000
# Backpressure e painel
MAX_QUEUE_PER_BED=50
DASHBOARD_FLUSH_MS=1000
